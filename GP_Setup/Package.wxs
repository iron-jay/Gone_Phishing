<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    Gone Phishing is a plain COM add-in, so there is nothing to self-register: the CLSID entries
    below are exactly what "regasm /codebase" produces, written declaratively so the installer
    stays repairable and uninstalls cleanly.

    ReportTo and Prefix can be supplied here as install-time defaults. They land in the add-in's
    own key under HKLM\Software, which only an administrator can write, and Group Policy
    supersedes them at runtime without needing them changed - see the administrative template
    installed alongside the assembly.
  -->

  <?define ClassId = "{2C6CF44D-AF64-4B2C-AA5D-59A64F09E8EF}" ?>
  <?define ProgId = "GonePhishing.Connect" ?>
  <?define ManagedClass = "Gone_Phishing.Connect" ?>
  <?define AssemblyName = "Gone Phishing, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" ?>
  <!--
    The leaf name must equal the ProgID above: Outlook uses the key name as the ProgID it looks
    up. LegacyAddInKey is the earlier, mismatched name and is removed on install.
  -->
  <?define AddInKey = "Software\Microsoft\Office\Outlook\Addins\GonePhishing.Connect" ?>
  <?define LegacyAddInKey = "Software\Microsoft\Office\Outlook\Addins\GonePhishing" ?>
  <!-- Settings live apart from the COM registration so uninstalling one never disturbs the other. -->
  <?define SettingsKey = "Software\iron-jay\GonePhishing" ?>

  <Package Name="Gone Phishing"
           Manufacturer="iron-jay"
           Version="1.5.0.0"
           UpgradeCode="8F119238-0A06-4A99-8C0E-5E9F7EB9B7E1"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <!--
      AllowSameVersionUpgrades matters during development: every build gets a fresh ProductCode,
      so without it two builds carrying the same version install side by side instead of
      replacing each other.
    -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!--
      The retired VSTO installers used their own UpgradeCodes, so a major upgrade cannot see
      them. Detect and remove them explicitly, otherwise they linger in Add/Remove Programs and
      keep registering an add-in whose .vsto manifest no longer exists.
    -->
    <Upgrade Id="{53FB3CD0-65A9-4B1C-A23C-342D4D0FCF90}">
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes" OnlyDetect="no" Property="LEGACYVSTOX64" />
    </Upgrade>
    <Upgrade Id="{A3EF95D3-8724-4015-A218-F4E937BCC902}">
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes" OnlyDetect="no" Property="LEGACYVSTOX86" />
    </Upgrade>

    <!-- Shown against the entry in Add/Remove Programs. -->
    <Icon Id="GonePhishing.ico" SourceFile="..\Gone-Phishing\Resources\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="GonePhishing.ico" />

    <MediaTemplate EmbedCab="yes" />

    <!--
      Optional install-time defaults, e.g.
        msiexec /i GonePhishing.msi REPORTTO=phishing@example.com "PREFIX=[Suspicious] " /qn
      Omit either to leave it to Group Policy. Each is written only when supplied, so an upgrade
      that passes nothing does not blank out a value an earlier install set.
    -->
    <Property Id="REPORTTO" Secure="yes" />
    <Property Id="PREFIX" Secure="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Gone Phishing">
        <!-- The .adml must sit in a language subfolder beside the .admx, so the contents of
             Policies mirror what the Group Policy Central Store expects and can be copied
             across as-is. -->
        <Directory Id="POLICYFOLDER" Name="Policies">
          <Directory Id="POLICYLANGFOLDER" Name="en-US" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Gone Phishing" Level="1">
      <ComponentRef Id="AddInAssembly" />
      <ComponentRef Id="OutlookRegistration" />
      <ComponentRef Id="OutlookRegistration32" />
      <ComponentRef Id="ReportToSetting" />
      <ComponentRef Id="PrefixSetting" />
      <ComponentRef Id="PolicyTemplate" />
      <ComponentRef Id="PolicyTemplateStrings" />
    </Feature>

    <ComponentGroup Id="AddInComponents">

      <!--
        The file and its COM registration share a component so they are installed, repaired and
        removed as a unit - the CodeBase values below point straight at the file.
      -->
      <Component Id="AddInAssembly" Directory="INSTALLFOLDER">
        <File Id="GonePhishingDll" Source="Gone Phishing.dll" KeyPath="yes" />

        <RegistryKey Root="HKLM" Key="Software\Classes\$(ProgId)">
          <RegistryValue Type="string" Value="$(ManagedClass)" />
          <RegistryValue Key="CLSID" Type="string" Value="$(ClassId)" />
        </RegistryKey>

        <RegistryKey Root="HKLM" Key="Software\Classes\CLSID\$(ClassId)">
          <RegistryValue Type="string" Value="$(ManagedClass)" />
          <RegistryValue Key="ProgId" Type="string" Value="$(ProgId)" />

          <!-- mscoree.dll is the shim; the values below tell it which managed class to load. -->
          <RegistryValue Key="InprocServer32" Type="string" Value="mscoree.dll" />
          <RegistryValue Key="InprocServer32" Name="ThreadingModel" Type="string" Value="Both" />
          <RegistryValue Key="InprocServer32" Name="Class" Type="string" Value="$(ManagedClass)" />
          <RegistryValue Key="InprocServer32" Name="Assembly" Type="string" Value="$(AssemblyName)" />
          <RegistryValue Key="InprocServer32" Name="RuntimeVersion" Type="string" Value="v4.0.30319" />
          <!-- Required because the assembly is not in the GAC. -->
          <RegistryValue Key="InprocServer32" Name="CodeBase" Type="string" Value="file:///[#GonePhishingDll]" />

          <RegistryValue Key="InprocServer32\1.0.0.0" Name="Class" Type="string" Value="$(ManagedClass)" />
          <RegistryValue Key="InprocServer32\1.0.0.0" Name="Assembly" Type="string" Value="$(AssemblyName)" />
          <RegistryValue Key="InprocServer32\1.0.0.0" Name="RuntimeVersion" Type="string" Value="v4.0.30319" />
          <RegistryValue Key="InprocServer32\1.0.0.0" Name="CodeBase" Type="string" Value="file:///[#GonePhishingDll]" />
        </RegistryKey>

        <!-- Marks the CLSID as managed. The key exists; it carries no value. -->
        <RegistryKey Root="HKLM"
                     Key="Software\Classes\CLSID\$(ClassId)\Implemented Categories\{62C8FE65-4EBB-45E7-B440-6E39B2CDBF29}"
                     ForceCreateOnInstall="yes"
                     ForceDeleteOnUninstall="yes" />
      </Component>

      <Component Id="OutlookRegistration" Directory="INSTALLFOLDER">
        <RegistryKey Root="HKLM" Key="$(AddInKey)">
          <RegistryValue Name="FriendlyName" Type="string" Value="Gone Phishing" KeyPath="yes" />
          <RegistryValue Name="Description" Type="string" Value="Report phishing and spam emails to your security team." />
          <RegistryValue Name="LoadBehavior" Type="integer" Value="3" />
        </RegistryKey>

        <!--
          Clears the mismatched key from earlier builds, and the Manifest value a VSTO install
          left behind. Either would make Outlook try - and fail - to load a second registration.
        -->
        <RemoveRegistryKey Root="HKLM" Key="$(LegacyAddInKey)" Action="removeOnInstall" />
      </Component>

      <!--
        The same registration again, forced into the 32-bit view, so one package serves 32-bit
        Outlook as well. Outlook only reads the registry view matching its own bitness, and the
        assembly is AnyCPU, so the single copy in Program Files loads happily in either host.
        Bitness="always32" is what redirects these writes to Software\WOW6432Node\...
      -->
      <!-- TARGETDIR, not INSTALLFOLDER: a 32-bit component may not sit in a 64-bit directory
           (ICE80), and this component installs registry values only. -->
      <Component Id="OutlookRegistration32" Directory="TARGETDIR" Bitness="always32">
        <RegistryKey Root="HKLM" Key="$(AddInKey)">
          <RegistryValue Name="FriendlyName" Type="string" Value="Gone Phishing" KeyPath="yes" />
          <RegistryValue Name="Description" Type="string" Value="Report phishing and spam emails to your security team." />
          <RegistryValue Name="LoadBehavior" Type="integer" Value="3" />
        </RegistryKey>

        <RegistryKey Root="HKLM" Key="Software\Classes\$(ProgId)">
          <RegistryValue Type="string" Value="$(ManagedClass)" />
          <RegistryValue Key="CLSID" Type="string" Value="$(ClassId)" />
        </RegistryKey>

        <RegistryKey Root="HKLM" Key="Software\Classes\CLSID\$(ClassId)">
          <RegistryValue Type="string" Value="$(ManagedClass)" />
          <RegistryValue Key="ProgId" Type="string" Value="$(ProgId)" />
          <RegistryValue Key="InprocServer32" Type="string" Value="mscoree.dll" />
          <RegistryValue Key="InprocServer32" Name="ThreadingModel" Type="string" Value="Both" />
          <RegistryValue Key="InprocServer32" Name="Class" Type="string" Value="$(ManagedClass)" />
          <RegistryValue Key="InprocServer32" Name="Assembly" Type="string" Value="$(AssemblyName)" />
          <RegistryValue Key="InprocServer32" Name="RuntimeVersion" Type="string" Value="v4.0.30319" />
          <RegistryValue Key="InprocServer32" Name="CodeBase" Type="string" Value="file:///[#GonePhishingDll]" />
          <RegistryValue Key="InprocServer32\1.0.0.0" Name="Class" Type="string" Value="$(ManagedClass)" />
          <RegistryValue Key="InprocServer32\1.0.0.0" Name="Assembly" Type="string" Value="$(AssemblyName)" />
          <RegistryValue Key="InprocServer32\1.0.0.0" Name="RuntimeVersion" Type="string" Value="v4.0.30319" />
          <RegistryValue Key="InprocServer32\1.0.0.0" Name="CodeBase" Type="string" Value="file:///[#GonePhishingDll]" />
        </RegistryKey>

        <RegistryKey Root="HKLM"
                     Key="Software\Classes\CLSID\$(ClassId)\Implemented Categories\{62C8FE65-4EBB-45E7-B440-6E39B2CDBF29}"
                     ForceCreateOnInstall="yes"
                     ForceDeleteOnUninstall="yes" />

        <RemoveRegistryKey Root="HKLM" Key="$(LegacyAddInKey)" Action="removeOnInstall" />
      </Component>

      <!--
        Install-time defaults. The add-in reads these last, after both policy locations, so a
        Group Policy value silently wins without these having to be removed or rewritten.
      -->
      <Component Id="ReportToSetting" Directory="INSTALLFOLDER" Condition="REPORTTO">
        <RegistryValue Root="HKLM" Key="$(SettingsKey)" Name="ReportTo" Type="string" Value="[REPORTTO]" KeyPath="yes" />
      </Component>

      <Component Id="PrefixSetting" Directory="INSTALLFOLDER" Condition="PREFIX">
        <RegistryValue Root="HKLM" Key="$(SettingsKey)" Name="Prefix" Type="string" Value="[PREFIX]" KeyPath="yes" />
      </Component>

      <!--
        Shipped for the administrator to copy into the domain Central Store; installing them here
        does not itself put any policy into effect.
      -->
      <Component Id="PolicyTemplate" Directory="POLICYFOLDER">
        <File Id="GonePhishingAdmx" Source="..\Policies\GonePhishing.admx" KeyPath="yes" />
      </Component>

      <Component Id="PolicyTemplateStrings" Directory="POLICYLANGFOLDER">
        <File Id="GonePhishingAdml" Source="..\Policies\en-US\GonePhishing.adml" KeyPath="yes" />
      </Component>

    </ComponentGroup>

  </Package>
</Wix>




